    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{base_url}}/api/auth/register",
            "description": "Registra un nuevo usuario y retorna token JWT.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Usuario Test\",\n  \"email\": \"usuario@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "name": "Created",
              "status": "Created",
              "code": 201,
              "header": [],
              "body": "{\n  \"success\": true,\n  \"token\": \"jwt_token_example\",\n  \"user\": {\n    \"id\": 1,\n    \"name\": \"Usuario Test\",\n    \"email\": \"usuario@example.com\",\n    \"role\": \"user\"\n  }\n}"
            },
            {
              "name": "Email Already Exists",
              "status": "Unprocessable Entity",
              "code": 422,
              "header": [],
              "body": "{\n  \"success\": false,\n  \"errors\": {\n    \"email\": [\n      \"El email ya está registrado.\"\n    ]\n  }\n}"
            },
            {
              "name": "Password Mismatch",
              "status": "Unprocessable Entity",
              "code": 422,
              "header": [],
              "body": "{\n  \"success\": false,\n  \"errors\": {\n    \"password\": [\n      \"La confirmación de contraseña no coincide.\"\n    ]\n  }\n}"
            },
            {
              "name": "Missing Required Fields",
              "status": "Unprocessable Entity",
              "code": 422,
              "header": [],
              "body": "{\n  \"success\": false,\n  \"errors\": {\n    \"name\": [\n      \"El campo name es requerido.\"\n    ],\n    \"email\": [\n      \"El campo email es requerido.\"\n    ],\n    \"password\": [\n      \"El campo password es requerido.\"\n    ],\n    \"password_confirmation\": [\n      \"El campo password_confirmation es requerido.\"\n    ]\n  }\n}"
            }
          ]
        },
